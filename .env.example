# Ejemplo: configura estas variables en Render Environment o en tu terminal.
# Este archivo no se carga automáticamente. Nunca subas claves a Git.
HOST=0.0.0.0
PORT=8787
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_COLLECTION_PREFIX=cronicas
# Opción A: JSON completo de la cuenta de servicio, como secreto del servidor.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Opción B: ruta a un archivo secreto (no usar ambas opciones).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=tu-clave-privada
# Solo pruebas locales; nunca en Render:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
